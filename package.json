{
  "name": "laya-compaction",
  "private": true,
  "description": "Claude Code plugin: verbatim context compaction guided by a Laya server on your network.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "test": "vitest run",
    "validate:plugin": "claude plugin validate .",
    "setup": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
